<IfModule mod_dir.c>
    DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.well-known/ - [L]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^bemsertanejofm\.com$ [NC]
    RewriteRule ^ https://bemsertanejofm.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|png|jpe?g|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
